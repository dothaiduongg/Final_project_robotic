<?xml version="1.0"?>
<launch>
  <arg name="map_file" default="$(find navstack_pub)/maps/my_map_lab.yaml"/>
  <arg name="open_rviz" default="true"/>
  <arg name="move_forward_only" default="false"/>
  
 
<node name="map_server" pkg="map_server" type="map_server" args="$(arg map_file)" output="screen">
</node>
  <!-- AMCL -->
  
  <include file="$(find navstack_pub)/launch/amcl.launch">
  </include>
  <!-- move_base -->

  <include file="$(find navstack_pub)/launch/move_base.launch">
    <arg name="move_forward_only" value="$(arg move_forward_only)"/>
  </include>

  <!-- Rviz -->
  <!-- <node name="rviz" pkg="rviz" type="rviz" args="-d $(find navstack_pub)/rviz/nav_stack.rviz" required="true" /> -->

</launch>
